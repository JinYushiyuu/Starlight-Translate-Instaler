<Window x:Class="Starlight_Translate_Instalador.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Starlight Launcher" Height="740" Width="1050"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#1e1e24"
        FontFamily="Segoe UI">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280"/> 
            <ColumnDefinition Width="*"/>   
        </Grid.ColumnDefinitions>

        <!-- ================= BARRA LATERAL ================= -->
        <Border Grid.Column="0" Background="#161920">
            <ListBox x:Name="ListaJogos" Background="Transparent" BorderThickness="0" 
                     Foreground="#aeb4bd" SelectionChanged="ListaJogos_SelectionChanged"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="15,8"/>
                        <Setter Property="Cursor" Value="Hand"/>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#2a2e38"/>
                                <Setter Property="Foreground" Value="#ffffff"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#3d4450"/>
                                <Setter Property="Foreground" Value="#ffffff"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </ListBox.ItemContainerStyle>

                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            
                            <Image Grid.Column="0" Source="{Binding Icone}" Width="32" Height="32" Stretch="UniformToFill" Margin="0,0,12,0">
                                <Image.Clip>
                                    <RectangleGeometry Rect="0,0,32,32" RadiusX="4" RadiusY="4"/>
                                </Image.Clip>
                            </Image>
                            <TextBlock Grid.Column="1" Text="{Binding Nome}" VerticalAlignment="Center" FontSize="13" TextWrapping="Wrap"/>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <!-- ================= ÁREA PRINCIPAL ================= -->
        <Grid Grid.Column="1" Background="#1b2838">
            <Grid.RowDefinitions>
                <RowDefinition Height="280"/> 
                <RowDefinition Height="*"/>   
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Background="#0b121a" ClipToBounds="True">
                <Image x:Name="ImgBanner" Stretch="UniformToFill" Opacity="0.8"/>
                
                <TextBlock x:Name="BannerTxt" Text="SELECIONE UM JOGO NA LISTA" 
                           Foreground="#ffffff" FontSize="28" FontWeight="Bold" 
                           HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.3"/>
                
                <!-- TAG DE STATUS -->
                <Border x:Name="TagStatusBorder" 
                        Background="#e74c3c" 
                        CornerRadius="12" 
                        Padding="12,5" 
                        HorizontalAlignment="Right" 
                        VerticalAlignment="Top" 
                        Margin="0,20,20,0" 
                        Panel.ZIndex="10">
                    <TextBlock x:Name="TxtStatusTraducao" 
                               Text="Em andamento" 
                               Foreground="White" 
                               FontSize="12" 
                               FontWeight="Bold"/>
                </Border>

                <!-- Botão Instalar Principal -->
                <Button x:Name="BtnInstalar" Content="INSTALAR" 
                        HorizontalAlignment="Left" VerticalAlignment="Bottom"
                        Margin="30,0,0,20" Width="210" Height="45"
                        Background="#47b900" Foreground="#ffffff" 
                        FontSize="14" FontWeight="Bold" BorderThickness="0" 
                        Cursor="Hand" Visibility="Hidden" Click="BtnInstalar_Click">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="4"/>
                        </Style>
                    </Button.Resources>
                </Button>

                <!-- PAINEL DE DOWNLOAD -->
                <Border x:Name="PainelDownload" HorizontalAlignment="Left" VerticalAlignment="Bottom" 
                        Margin="30,0,0,20" Padding="12" CornerRadius="6" Visibility="Hidden">
                    <Border.Background>
                        <SolidColorBrush Color="#0b121a" Opacity="0.85"/>
                    </Border.Background>
                    <StackPanel Orientation="Vertical">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <ProgressBar x:Name="BarraDownloadReal" Width="180" Height="20" 
                                         Background="#1c212b" Foreground="#47b900" BorderThickness="0" 
                                         VerticalAlignment="Center" Margin="0,0,8,0"/>

                            <Button x:Name="BtnPausar" Content="⏸" Width="28" Height="28" 
                                    Background="#2a2e38" Foreground="#ffffff" FontSize="12" 
                                    BorderThickness="0" Cursor="Hand" Click="BtnPausar_Click"
                                    VerticalAlignment="Center" Margin="0,0,4,0">
                                <Button.Resources>
                                    <Style TargetType="Border"><Setter Property="CornerRadius" Value="4"/></Style>
                                </Button.Resources>
                            </Button>

                            <Button x:Name="BtnCancelar" Content="✕" Width="28" Height="28" 
                                    Background="#a83232" Foreground="#ffffff" FontSize="12" 
                                    BorderThickness="0" Cursor="Hand" Click="BtnCancelar_Click"
                                    VerticalAlignment="Center">
                                <Button.Resources>
                                    <Style TargetType="Border"><Setter Property="CornerRadius" Value="4"/></Style>
                                </Button.Resources>
                            </Button>
                        </StackPanel>

                        <TextBlock x:Name="TxtStatusDownload" Text="Iniciando..." Foreground="#ffffff" FontSize="11" FontWeight="SemiBold"/>
                    </StackPanel>
                </Border>

                <!-- PAINEL DE STATUS DA TRADUÇÃO -->
                <Border x:Name="PainelProgresso" HorizontalAlignment="Right" VerticalAlignment="Bottom" 
                        Margin="0,0,20,20" Width="160" Padding="12" CornerRadius="6" Visibility="Hidden">
                    <Border.Background>
                        <SolidColorBrush Color="#0b121a" Opacity="0.85"/>
                    </Border.Background>
                    <StackPanel>
                        <!-- Traduzido -->
                        <Grid Margin="0,0,0,4">
                            <TextBlock Text="Traduzido" Foreground="#aeb4bd" FontSize="11" HorizontalAlignment="Left"/>
                            <TextBlock x:Name="TxtPctTraducao" Text="0%" Foreground="#00bbf9" FontSize="11" FontWeight="Bold" HorizontalAlignment="Right"/>
                        </Grid>
                        <Border Height="5" Background="#1c212b" CornerRadius="2.5" Margin="0,0,0,12">
                            <Border x:Name="BarraTraducao" HorizontalAlignment="Left" Width="0" CornerRadius="2.5">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#8c52ff" Offset="0.0"/>
                                        <GradientStop Color="#00bbf9" Offset="1.0"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                        </Border>

                        <!-- Revisão -->
                        <Grid Margin="0,0,0,4">
                            <TextBlock Text="Revisão" Foreground="#aeb4bd" FontSize="11" HorizontalAlignment="Left"/>
                            <TextBlock x:Name="TxtPctRevisao" Text="0%" Foreground="#00bbf9" FontSize="11" FontWeight="Bold" HorizontalAlignment="Right"/>
                        </Grid>
                        <Border Height="5" Background="#1c212b" CornerRadius="2.5">
                            <Border x:Name="BarraRevisao" HorizontalAlignment="Left" Width="0" CornerRadius="2.5">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#8c52ff" Offset="0.0"/>
                                        <GradientStop Color="#00bbf9" Offset="1.0"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Área de Textos, Logo e Créditos -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="40,25,40,30">
                    <TextBlock x:Name="TituloJogo" Text="" Foreground="#ffffff" FontSize="24" FontWeight="Bold" Margin="0,0,0,10" Visibility="Hidden" TextWrapping="Wrap"/>
                    <TextBlock x:Name="DescricaoJogo" Text="" Foreground="#d2d6dc" FontSize="13" Margin="0,0,0,15" Visibility="Hidden" TextWrapping="Wrap" LineHeight="19"/>

                    <!-- LOGO DO JOGO -->
                    <Image x:Name="ImgLogoJogo" Height="120" HorizontalAlignment="Left" Margin="0,0,0,20" Stretch="Uniform" Visibility="Collapsed"/>

                    <!-- PAINEL DE CRÉDITOS EM 3 COLUNAS ALINHADAS -->
                    <Border x:Name="PainelCreditos" Background="#141820" BorderBrush="#252a34" BorderThickness="1" CornerRadius="6" Padding="16" Margin="0,0,0,0" Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock Text="CRÉDITOS DA TRADUÇÃO" FontFamily="Segoe UI Semibold" Foreground="#8c95a5" FontSize="12" FontWeight="Bold" Margin="0,0,0,14"/>

                            <!-- Grid de Colunas com Larguras Proporcionais -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.4*"/>
                                    <ColumnDefinition Width="1*"/>
                                    <ColumnDefinition Width="1.3*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Coluna 1: Tradução e Revisão -->
                                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                    <TextBlock Text="🌎 TRADUÇÃO &amp; REVISÃO" FontFamily="Segoe UI Semibold" Foreground="#ffffff" FontSize="11" FontWeight="Bold" Margin="0,0,0,6"/>
                                    <ItemsControl x:Name="ListaTraducaoRevisao">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding}" FontFamily="Segoe UI Semibold" Foreground="#d2d6dc" FontSize="12" Margin="0,2,0,2" TextWrapping="Wrap"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>

                                <!-- Coluna 2: Design Gráfico e Ferramentas -->
                                <StackPanel Grid.Column="1" Margin="12,0,12,0">
                                    <TextBlock Text="🎨 DESIGN GRÁFICO" FontFamily="Segoe UI Semibold" Foreground="#ffffff" FontSize="11" FontWeight="Bold" Margin="0,0,0,4"/>
                                    <ItemsControl x:Name="ListaDesignGrafico" Margin="0,0,0,10">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding}" FontFamily="Segoe UI Semibold" Foreground="#d2d6dc" FontSize="12" Margin="0,2,0,2" TextWrapping="Wrap"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <TextBlock Text="🛠️ FERRAMENTAS" FontFamily="Segoe UI Semibold" Foreground="#ffffff" FontSize="11" FontWeight="Bold" Margin="0,0,0,4"/>
                                    <ItemsControl x:Name="ListaFerramentas">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding}" FontFamily="Segoe UI Semibold" Foreground="#d2d6dc" FontSize="12" Margin="0,2,0,2" TextWrapping="Wrap"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>

                                <!-- Coluna 3: Agradecimentos Especiais -->
                                <StackPanel Grid.Column="2" Margin="10,0,0,0">
                                    <TextBlock Text="⭐ AGRADECIMENTOS ESPECIAIS" FontFamily="Segoe UI Semibold" Foreground="#00bbf9" FontSize="11" FontWeight="Bold" Margin="0,0,0,6"/>
                                    <ItemsControl x:Name="ListaOutros">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding}" FontFamily="Segoe UI Semibold" Foreground="#d2d6dc" FontSize="12" Margin="0,2,0,2" TextWrapping="Wrap"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>