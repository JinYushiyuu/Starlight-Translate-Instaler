<Window x:Class="Starlight_Translate_Instalador.IntroWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Starlight Translate Instaler" Height="550" Width="800"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#1e1e24"
        FontFamily="Segoe UI">
    <Grid>
        <!-- Imagem de Fundo (Slider Aleatório) -->
        <Image x:Name="ImgSlider" Stretch="UniformToFill"/>
        
        <!-- Camada preta com opacidade para contraste -->
        <Rectangle Fill="Black" Opacity="0.55"/>

        <!-- Conteúdo Central -->
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="680">
            <TextBlock Text="Starlight Translate Instaler" 
                       Foreground="White" FontSize="32" FontWeight="Bold" 
                       HorizontalAlignment="Center" Margin="0,0,0,10" TextAlignment="Center"/>
            
            <TextBlock Text="Um instalador que une as traduções da Starlight Translate e Phantasie Translate" 
                       Foreground="#d2d6dc" FontSize="14" 
                       HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Margin="0,0,0,40"/>

            <Button Content="INICIAR" Width="200" Height="50"
                    Background="#47b900" Foreground="White" 
                    FontSize="16" FontWeight="Bold" BorderThickness="0" 
                    Cursor="Hand" Click="BtnIniciar_Click" HorizontalAlignment="Center">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="6"/>
                    </Style>
                </Button.Resources>
            </Button>
        </StackPanel>

        <!-- Desenvolvido por (Canto Inferior Esquerdo com Sombra) -->
        <TextBlock Text="Desenvolvido por Jin_Yushiyuu" 
                   Foreground="#e2e8f0" FontSize="12" FontWeight="Bold"
                   HorizontalAlignment="Left" VerticalAlignment="Bottom" 
                   Margin="25,0,0,22">
            <TextBlock.Effect>
                <DropShadowEffect Color="Black" BlurRadius="5" ShadowDepth="1" Opacity="0.9"/>
            </TextBlock.Effect>
        </TextBlock>

        <!-- Botão de Engrenagem (Configurações) no Canto Inferior Direito -->
        <Button Content="⚙" Width="40" Height="40"
                HorizontalAlignment="Right" VerticalAlignment="Bottom"
                Margin="0,0,25,20" Background="#2a2e38" Foreground="White"
                FontSize="18" FontWeight="Bold" BorderThickness="0"
                Cursor="Hand" Click="BtnConfig_Click" ToolTip="Alterar pasta de download">
            <Button.Resources>
                <Style TargetType="Border">
                    <Setter Property="CornerRadius" Value="20"/>
                </Style>
            </Button.Resources>
        </Button>
    </Grid>
</Window>